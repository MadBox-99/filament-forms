{
    "name": "madbox-99/filament-forms",
    "description": "Form builder and submission management plugin for Filament v5 - dynamic forms, submissions tracking, email notifications",
    "type": "library",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "forms",
        "form-builder",
        "submissions",
        "contact-forms"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Zoltán Tamás Szabó",
            "email": "zoli.szabok@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "laravel/framework": "^12.0 || ^13.0",
        "nunomaduro/essentials": "^1.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "laravel/pint": "^1.0",
        "orchestra/testbench": "^10.0 || ^11.0",
        "rector/rector": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Madbox99\\FilamentForms\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Madbox99\\FilamentForms\\FilamentFormsServiceProvider"
            ]
        }
    },
    "scripts": {
        "lint": "pint",
        "refactor": "rector"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
